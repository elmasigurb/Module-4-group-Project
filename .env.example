# Copy this file to .env and fill in the values.
# .env must NEVER be committed (it is in .gitignore).

# Supabase (Project Settings → API). These two values are safe to use in the frontend.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# The Claude API key does NOT go here. It is stored as a secret
# in the Supabase Edge Function (supabase secrets set ANTHROPIC_API_KEY=...)
